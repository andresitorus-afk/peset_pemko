# Real-time chat (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=peset
REVERB_APP_KEY=peset-chat-key
REVERB_APP_SECRET=peset-chat-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=reverb
REVERB_SERVER_PORT=8080
