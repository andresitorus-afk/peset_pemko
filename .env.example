APP_NAME=PESET
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pemanfaatan_aset
DB_USERNAME=secret
DB_PASSWORD=secret

SESSION_DRIVER=database
